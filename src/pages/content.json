  "/about": {
    "name": "About",
    "title": "About QuiviTech | QuiviTech Malaysia",
    "description": "Meet QuiviTech, a Malaysian custom PC brand focused on transparent pricing, premium craftsmanship and dependable long-term support.",
    "html": "<main class=\"site-main\" id=\"main\"><section class=\"page-hero\"><div class=\"container\"><span class=\"kicker\">ABOUT US / OUR STORY</span><h1 class=\"headline h1\">Not just PCs.<br/>People first.</h1><p>We make powerful technology more accessible—with clear advice, considered workmanship and ongoing support.</p><a class=\"hero-scroll-arrow\" href=\"#page-content\" aria-label=\"Scroll to the next section\"><span aria-hidden=\"true\"></span></a></div></section><section id=\"page-content\" class=\"section\"><div class=\"container split\"><div data-reveal=\"\"><span class=\"kicker\">OUR THINKING</span><h2 class=\"headline h2\">Built on trust.</h2><p>QuiviTech exists to make custom PC building feel easier. Our approach combines premium assembly, practical recommendations and genuine care throughout ownership.</p><p class=\"caption-note\">Replace the sample team photo and add approved co-founder profiles and brand history before launch.</p></div><div class=\"photobox\"><img alt=\"Illustrative team collaboration photograph\" data-parallax=\"\" decoding=\"async\" loading=\"lazy\" src=\"/team-collaboration.jpg\"/></div></div></section><section class=\"section soft\"><div class=\"container\"><div class=\"section-head\" data-reveal=\"\"><div><span class=\"kicker\">THE QUIVITECH STANDARD</span><h2 class=\"headline h2\">Harga Telus.<br/>Kualiti Premium.</h2></div></div><div class=\"cards three\" data-stagger=\"\"><div class=\"component\"><div class=\"symbol\">01</div><h3>Honesty</h3><p>Recommendations you can understand.</p></div><div class=\"component\"><div class=\"symbol\">02</div><h3>Craft</h3><p>Care in every visible and hidden detail.</p></div><div class=\"component\"><div class=\"symbol\">03</div><h3>Continuity</h3><p>Support beyond the final handover.</p></div></div></div></section><section class=\"section site-cta-section\"><div class=\"container\"><div class=\"quote-band site-cta\" data-reveal=\"\"><div class=\"site-cta-copy\"><h2 class=\"headline\">The Dream. Made Real.</h2><p>Tell us your budget, needs and ideal setup.</p></div><a class=\"round-btn\" href=\"/contact\">Contact Us <span data-icon=\"ArrowUpRight\"></span></a></div></div></section></main>"
  },
  "/contact": {
    "name": "Contact",
    "title": "Contact QuiviTech | QuiviTech Malaysia",
    "description": "Contact QuiviTech for custom PC quotes, service bookings, upgrades, membership enquiries and warranty support in Malaysia.",
    "html": "<main class=\"site-main\" id=\"main\"><section class=\"page-hero contact-hero\"><div class=\"container contact-hero-grid\"><div><span class=\"kicker\">CONTACT / LET’S TALK</span><h1 class=\"headline h1\">Start with<br/>your vision.</h1><p>Custom PC, upgrade or support request? Share a few details and we’ll help you plan the next step.</p><a class=\"hero-scroll-arrow\" href=\"#page-content\" aria-label=\"Scroll to the next section\"><span aria-hidden=\"true\"></span></a></div><div class=\"placeholder-map contact-hero-map\" role=\"img\" aria-label=\"Placeholder map for the QuiviTech location\"><div><span class=\"contact-map-pin\" aria-hidden=\"true\"></span><b>QuiviTech location</b><p>Map placeholder</p></div></div></div></section><section id=\"page-content\" class=\"section\"><div class=\"container split contact-form-grid\"><div class=\"contact-form-copy\" data-reveal=\"\"><span class=\"kicker\">TALK TO QUIVITECH</span><h2 class=\"headline h2\">Tell us what you need.</h2><p>Tell us about your build, upgrade, or support request.</p><ul class=\"contact-details\"><li><span data-icon=\"Phone\"></span><div><strong>Phone</strong><span>Number to be confirmed</span></div></li><li><span data-icon=\"Mail\"></span><div><strong>Email</strong><span>Address to be confirmed</span></div></li><li><div><strong>Follow us on</strong><ul class=\"contact-social\" aria-label=\"Social platforms\"><li aria-label=\"Facebook\"><span data-icon=\"Facebook\"></span></li><li aria-label=\"Instagram\"><span data-icon=\"Instagram\"></span></li><li aria-label=\"LinkedIn\"><span data-icon=\"Linkedin\"></span></li><li aria-label=\"YouTube\"><span data-icon=\"Youtube\"></span></li></ul></div></li></ul></div><form id=\"quote-request\" class=\"form\" data-demo-form=\"\"><label for=\"name\">Name</label><input id=\"name\" name=\"name\" placeholder=\"Your full name\" required=\"\"/><label for=\"email\">Email</label><input id=\"email\" name=\"email\" placeholder=\"you@example.com\" required=\"\" type=\"email\"/><label for=\"service\">Enquiry type</label><select id=\"service\" name=\"service\" required=\"\"><option value=\"\">Select a service</option><option>Custom PC / Quivi Craft</option><option>QuiviServe membership</option><option>QuiviCare warranty</option><option>QuiviThread</option><option>Quivi Plus</option><option>Quivi Merch</option></select><label for=\"message\">Tell us more</label><textarea id=\"message\" name=\"message\" placeholder=\"Your goal, preferred budget or problem... \" required=\"\"></textarea><button class=\"round-btn\" type=\"submit\">Send Enquiry <span data-icon=\"ArrowUpRight\"></span></button><p class=\"caption-note form-error\" role=\"alert\"></p></form></div></section><section class=\"testimonials section\"><div class=\"container\"><div class=\"editorial-heading\" data-reveal=\"\"><span class=\"kicker\">THE PEOPLE BEHIND THE BUILDS</span><h2 class=\"headline h2\">From Our Customers<span class=\"dot-accent\">.</span></h2><p>What matters most is how the experience feels.</p></div><div class=\"review-slider\" role=\"region\" aria-label=\"Testimonials\"><div class=\"review-grid\" tabindex=\"0\" aria-label=\"Slides\"><article><span>01 / CLEAR ADVICE</span><h3>Less guesswork.</h3><p>Understand your options before committing to a build.</p></article><article><span>02 / THOUGHTFUL BUILDS</span><h3>Made for your needs.</h3><p>Performance, aesthetics and budget considered together.</p></article><article><span>03 / ONGOING SUPPORT</span><h3>Beyond the handover.</h3><p>Practical guidance for upgrades and maintenance.</p></article></div><div class=\"review-controls\"><button type=\"button\" class=\"reviews-prev\" aria-label=\"Previous slide\"><span data-icon=\"ArrowLeft\"></span></button><span class=\"review-position\"></span><button type=\"button\" class=\"reviews-next\" aria-label=\"Next slide\"><span data-icon=\"ArrowRight\"></span></button></div></div></div></section></main>"
  },
  "/policies": {
    "name": "Policies",
    "title": "QuiviTech Policies and Warranty Information | QuiviTech Malaysia",
    "description": "Review QuiviTech policy information related to custom PC orders, service terms, component warranties and personal data.",
    "html": "<main class=\"site-main\" id=\"main\"><section class=\"page-hero\"><div class=\"container\"><span class=\"kicker\">POLICIES / TRANSPARENCY</span><h1 class=\"headline h1\">Everything clear.<br/>In one place.</h1><p>Our policies are here to help you understand orders, warranty, services and privacy.</p><a class=\"hero-scroll-arrow\" href=\"#page-content\" aria-label=\"Scroll to the next section\"><span aria-hidden=\"true\"></span></a></div></section><section id=\"page-content\" class=\"section\"><div class=\"container policy-text\"><span class=\"chip\">DRAFT TEMPLATE / APPROVAL REQUIRED</span><h2>Warranty and support</h2><p>Component coverage, eligible products, warranty duration and claim procedures must be described in the approved purchase and warranty documents. Terms differ by manufacturer and component.</p><h2>Custom PC orders</h2><p>Publish approved information about quotations, deposits, order acceptance, lead times, specification changes, cancellations and refunds.</p><h2>Service and maintenance</h2><p>Explain diagnostic fees, scope approval, pricing, appointment scheduling and any limitations for third-party hardware or existing faults.</p><h2>Privacy policy</h2><p>Specify information collected in website enquiries, the purpose of collection, retention, security, communication preferences and contact options.</p><h2>Contact</h2><p>For questions about official terms, use the QuiviTech contact page.</p><p class=\"caption-note\">Illustrative drafting copy only. The business should approve full policies and verify compliance with applicable Malaysian law prior to launch.</p></div></section></main>"
  }
}